# freshcart-pipelines environment configuration
# Copy this file to .env and fill in your values (do not commit .env to git)

# RabbitMQ / AMQP broker connection (Part D)
# Local Docker broker: amqp://guest:guest@localhost:5672/
# CloudAMQP Free Instance: amqps://username:password@hostname/vhost
AMQP_URL=amqp://guest:guest@localhost:5672/

# Snowflake credentials (Part B)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=FRESHCART_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
